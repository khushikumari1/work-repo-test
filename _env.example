# AWS Bedrock Configuration
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# Claude Model Configuration
# Available models:
# - us.anthropic.claude-sonnet-5 (Latest, same as claude.ai)
# - us.anthropic.claude-sonnet-4-6 (Claude Sonnet 4.6)
# - us.anthropic.claude-haiku-4-5 (Fast and cheap)
# - us.anthropic.claude-opus-5 (Most powerful)
# - anthropic.claude-3-haiku-20240307-v1:0 (Legacy, cheapest)
CLAUDE_MODEL_ID=us.anthropic.claude-sonnet-5

# Temperature: 0.0 = deterministic, 1.0 = creative (default on claude.ai)
CLAUDE_TEMPERATURE=0.1

# Maximum tokens for response
MAX_TOKENS=100000
